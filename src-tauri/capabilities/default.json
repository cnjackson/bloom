{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bloom rules-window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:webview:allow-internal-toggle-devtools",
    "clipboard-manager:default",
    "autostart:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:scope",
    {
      "identifier": "fs:scope",
      "description": "Restrict fs to user-picked paths",
      "allow": [{ "path": "**" }]
    }
  ]
}
